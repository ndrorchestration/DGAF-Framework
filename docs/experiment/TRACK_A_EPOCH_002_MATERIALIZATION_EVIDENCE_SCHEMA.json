{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndrorchestration/DGAF-Framework/docs/experiment/TRACK_A_EPOCH_002_MATERIALIZATION_EVIDENCE_SCHEMA.json",
  "title": "Track A Epoch 002 controlled materialization evidence manifest",
  "description": "Non-authorizing evidence for deterministic construction of a future analysis-ready unblinded input after an accepted bounded unblinding decision. The manifest contains only identities, digests, counts, retention metadata, and fail-closed non-effect assertions; it contains no custody private key, passphrase, blinding secret, protected plaintext mapping, decrypted mapping payload, or empirical analysis result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "protocol_id",
    "epoch",
    "evidence_workflow_run_id",
    "evidence_artifact_id",
    "evidence_tooling_commit_sha",
    "materializer_path",
    "materializer_commit_sha",
    "materializer_blob_sha",
    "dataset_lock_record_id",
    "dataset_lock_commit_sha",
    "dataset_lock_receipt_sha256",
    "unblinding_decision_record_id",
    "unblinding_decision_commit_sha",
    "unblinding_decision_sha256",
    "public_artifact",
    "protected_artifact",
    "materialized_input_sha256",
    "materialization_manifest_sha256",
    "materialization_sidecar_sha256",
    "paired_seed_units",
    "record_count",
    "structure_validation",
    "durable_retention",
    "custody_class",
    "independent_custody",
    "secret_material_persisted",
    "outcome_aggregation_performed",
    "primary_analysis_authorized",
    "primary_analysis_run",
    "historical_pooling_allowed",
    "epoch_001_pooling_allowed",
    "epoch_004_substitution_allowed",
    "high_assurance_authorized",
    "scientific_n_increment",
    "canonical_dgaf_efficacy",
    "materialization_evidence_status"
  ],
  "properties": {
    "record_type": {"const": "TRACK_A_EPOCH_002_MATERIALIZATION_EVIDENCE"},
    "schema_version": {"const": 1},
    "protocol_id": {"const": "PDMAL-TRACK-A-TOPOLOGY-ROBUSTNESS-EPOCH-002"},
    "epoch": {"const": 2},
    "evidence_workflow_run_id": {"type": "integer", "minimum": 1},
    "evidence_artifact_id": {"type": "integer", "minimum": 1},
    "evidence_tooling_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "materializer_path": {"const": "scripts/materialize_track_a_epoch_002_unblinded_input.py"},
    "materializer_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "materializer_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dataset_lock_record_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{7,127}$"},
    "dataset_lock_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dataset_lock_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unblinding_decision_record_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{7,127}$"},
    "unblinding_decision_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "unblinding_decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "name", "archive_sha256", "manifest_sha256"],
      "properties": {
        "artifact_id": {"type": "integer", "minimum": 1},
        "name": {"const": "track-a-epoch-002-public-blinded"},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "protected_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "name",
        "archive_sha256",
        "ciphertext_sha256",
        "plaintext_tar_sha256",
        "custody_certificate_sha256",
        "custody_certificate_public_key_der_sha256"
      ],
      "properties": {
        "artifact_id": {"type": "integer", "minimum": 1},
        "name": {"const": "track-a-epoch-002-protected-encrypted"},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ciphertext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plaintext_tar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "custody_certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "custody_certificate_public_key_der_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "materialized_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialization_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialization_sidecar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paired_seed_units": {"const": 50},
    "record_count": {"const": 2250},
    "structure_validation": {"const": "PASS"},
    "durable_retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "id"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["GITHUB_ACTIONS_ARTIFACT", "GITHUB_RELEASE_ASSET", "LOCAL_CUSTODY_ARCHIVE"]
        },
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "custody_class": {"const": "SAME_SYSTEM_NONINDEPENDENT"},
    "independent_custody": {"const": false},
    "secret_material_persisted": {"const": false},
    "outcome_aggregation_performed": {"const": false},
    "primary_analysis_authorized": {"const": false},
    "primary_analysis_run": {"const": false},
    "historical_pooling_allowed": {"const": false},
    "epoch_001_pooling_allowed": {"const": false},
    "epoch_004_substitution_allowed": {"const": false},
    "high_assurance_authorized": {"const": false},
    "scientific_n_increment": {"const": 0},
    "canonical_dgaf_efficacy": {"const": "NOT_ESTABLISHED"},
    "materialization_evidence_status": {"const": "MATERIALIZATION_PASS_PENDING_REPOSITORY_RECEIPT"}
  }
}
