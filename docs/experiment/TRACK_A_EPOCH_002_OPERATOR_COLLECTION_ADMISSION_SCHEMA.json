{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndrorchestration/DGAF-Framework/docs/experiment/TRACK_A_EPOCH_002_OPERATOR_COLLECTION_ADMISSION_SCHEMA.json",
  "title": "Track A Epoch 002 operator-executed collection admission",
  "description": "Non-authorizing content-addressed provenance record for an authorized collection executed outside GitHub Actions. It does not expose protected plaintext, authorize unblinding or analysis, or establish efficacy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "protocol_id",
    "epoch",
    "collection_execution_class",
    "collection_authorization_commit_sha",
    "frozen_candidate_sha",
    "frozen_candidate_tree_sha",
    "python_version",
    "requirements_lock_blob_sha",
    "collection_execution_receipt_sha256",
    "paired_seed_units",
    "blinded_observations",
    "public_retention",
    "protected_retention",
    "custody_class",
    "independent_custody",
    "outcomes_inspected_for_admission",
    "outcome_aggregation_performed",
    "unblinding_authorized",
    "primary_analysis_authorized",
    "historical_pooling_allowed",
    "epoch_004_substitution_allowed",
    "high_assurance_authorized",
    "scientific_n_increment",
    "canonical_dgaf_efficacy",
    "admission_status"
  ],
  "properties": {
    "record_type": {"const": "TRACK_A_EPOCH_002_OPERATOR_COLLECTION_ADMISSION"},
    "schema_version": {"const": 1},
    "protocol_id": {"const": "PDMAL-TRACK-A-TOPOLOGY-ROBUSTNESS-EPOCH-002"},
    "epoch": {"const": 2},
    "collection_execution_class": {"const": "OPERATOR_CODESPACE"},
    "collection_authorization_commit_sha": {"const": "563152fdb254b8ee948a693c287126a8bf8314b8"},
    "frozen_candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frozen_candidate_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "python_version": {"const": "3.12.3"},
    "requirements_lock_blob_sha": {"const": "00c1f779e97030f9b25ae494642edb31b5b09de5"},
    "collection_execution_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paired_seed_units": {"const": 50},
    "blinded_observations": {"const": 2250},
    "public_retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size_bytes", "archive_sha256", "manifest_sha256"],
      "properties": {
        "name": {"const": "track-a-epoch-002-public-blinded"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "protected_retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size_bytes",
        "archive_sha256",
        "ciphertext_sha256",
        "plaintext_tar_sha256",
        "custody_certificate_sha256",
        "custody_certificate_public_key_der_sha256"
      ],
      "properties": {
        "name": {"const": "track-a-epoch-002-protected-encrypted"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ciphertext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plaintext_tar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "custody_certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "custody_certificate_public_key_der_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "custody_class": {"const": "SAME_SYSTEM_NONINDEPENDENT"},
    "independent_custody": {"const": false},
    "outcomes_inspected_for_admission": {"const": false},
    "outcome_aggregation_performed": {"const": false},
    "unblinding_authorized": {"const": false},
    "primary_analysis_authorized": {"const": false},
    "historical_pooling_allowed": {"const": false},
    "epoch_004_substitution_allowed": {"const": false},
    "high_assurance_authorized": {"const": false},
    "scientific_n_increment": {"const": 0},
    "canonical_dgaf_efficacy": {"const": "NOT_ESTABLISHED"},
    "admission_status": {"const": "CONTENT_ADDRESSED_PENDING_DATASET_LOCK"}
  }
}
