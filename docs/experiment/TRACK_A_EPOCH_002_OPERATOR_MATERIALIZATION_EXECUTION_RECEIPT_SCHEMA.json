{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndrorchestration/DGAF-Framework/docs/experiment/TRACK_A_EPOCH_002_OPERATOR_MATERIALIZATION_EXECUTION_RECEIPT_SCHEMA.json",
  "title": "Track A Epoch 002 operator materialization execution receipt",
  "description": "Closed, non-authorizing receipt for one successful operator-controlled Stage-2 materialization execution. This receipt is evidence inside the operator bundle; it is not the repository MATERIALIZATION_RECEIPT and grants no analysis authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "protocol_id",
    "status",
    "evidence_execution_class",
    "materializer_path",
    "materializer_commit_sha",
    "materializer_blob_sha",
    "materialized_input_sha256",
    "materialization_manifest_sha256",
    "materialization_sidecar_sha256",
    "paired_seed_units",
    "record_count",
    "secret_material_persisted",
    "outcome_aggregation_performed",
    "primary_analysis_authorized",
    "primary_analysis_run",
    "repository_materialization_established",
    "scientific_n_increment",
    "canonical_dgaf_efficacy",
    "authorization_effect"
  ],
  "properties": {
    "record_type": {"const": "TRACK_A_EPOCH_002_OPERATOR_MATERIALIZATION_EXECUTION_RECEIPT"},
    "schema_version": {"const": 1},
    "protocol_id": {"const": "PDMAL-TRACK-A-TOPOLOGY-ROBUSTNESS-EPOCH-002"},
    "status": {"const": "PASS"},
    "evidence_execution_class": {"const": "OPERATOR_CODESPACE"},
    "materializer_path": {"const": "scripts/materialize_track_a_epoch_002_unblinded_input.py"},
    "materializer_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "materializer_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "materialized_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialization_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialization_sidecar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paired_seed_units": {"const": 50},
    "record_count": {"const": 2250},
    "secret_material_persisted": {"const": false},
    "outcome_aggregation_performed": {"const": false},
    "primary_analysis_authorized": {"const": false},
    "primary_analysis_run": {"const": false},
    "repository_materialization_established": {"const": false},
    "scientific_n_increment": {"const": 0},
    "canonical_dgaf_efficacy": {"const": "NOT_ESTABLISHED"},
    "authorization_effect": {"const": "NONE"}
  }
}
