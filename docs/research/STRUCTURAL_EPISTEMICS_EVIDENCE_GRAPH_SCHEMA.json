{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndrorchestration/DGAF-Framework/blob/main/docs/research/STRUCTURAL_EPISTEMICS_EVIDENCE_GRAPH_SCHEMA.json",
  "title": "Structural Epistemics Evidence Graph",
  "type": "object",
  "required": ["record_type", "schema_version", "graph_id", "claims", "evidence", "relations"],
  "properties": {
    "record_type": {"const": "STRUCTURAL_EPISTEMICS_EVIDENCE_GRAPH"},
    "schema_version": {"const": 1},
    "graph_id": {"type": "string", "pattern": "^EGRAPH-[A-Z0-9][A-Z0-9._-]*$"},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceNode"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "evidenceNode": {
      "type": "object",
      "required": [
        "evidence_id",
        "evidence_class",
        "source_roots",
        "dependency_roots",
        "observed_at",
        "validity",
        "provenance_ref"
      ],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EVID-[A-Z0-9][A-Z0-9._-]*$"},
        "evidence_class": {
          "enum": [
            "PRIMARY_SOURCE",
            "EXTERNAL_SOURCE",
            "MEASUREMENT",
            "EXPERIMENT",
            "CAUSAL_DESIGN",
            "DERIVATION",
            "VERIFICATION",
            "ATTESTATION",
            "NEGATIVE_RESULT",
            "COUNTEREVIDENCE"
          ]
        },
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dependency_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observed_at": {"type": "string", "minLength": 1},
        "validity": {
          "type": "object",
          "required": ["state", "review_condition"],
          "properties": {
            "state": {"enum": ["CURRENT", "STALE", "SUPERSEDED", "RETRACTED", "UNKNOWN"]},
            "review_condition": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "provenance_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["relation_id", "relation_type", "source_id", "target_id"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^REL-[A-Z0-9][A-Z0-9._-]*$"},
        "relation_type": {
          "enum": [
            "SUPPORTS",
            "CONTRADICTS",
            "DERIVED_FROM",
            "REPLICATES",
            "SHARES_SOURCE_ROOT",
            "SHARES_MODEL_LINEAGE",
            "SHARES_PROMPT_OR_POLICY",
            "SHARES_TOOL_OUTPUT",
            "DEFEATS",
            "SUPERSEDES",
            "RETRACTS",
            "VALID_DURING"
          ]
        },
        "source_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "scope": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
