{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndrorchestration/DGAF-Framework/blob/main/docs/research/STRUCTURAL_EPISTEMICS_CLAIM_RECORD_SCHEMA.json",
  "title": "Structural Epistemics ClaimRecord",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "claim_id",
    "proposition",
    "claim_class",
    "scope",
    "temporal_validity",
    "source_roots",
    "dependency_signature",
    "supporting_evidence_ids",
    "contradicting_evidence_ids",
    "defeaters",
    "uncertainty",
    "calibration_status",
    "verification_status",
    "epistemic_state",
    "applicability_state",
    "causal_level",
    "authorization_relevance",
    "supersedes",
    "superseded_by",
    "retraction"
  ],
  "properties": {
    "record_type": {"const": "STRUCTURAL_EPISTEMICS_CLAIM_RECORD"},
    "schema_version": {"const": 1},
    "claim_id": {"type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9._-]*$"},
    "proposition": {"type": "string", "minLength": 1},
    "claim_class": {
      "enum": [
        "FACT",
        "OBSERVATION",
        "DEMONSTRATION",
        "INFERENCE",
        "HYPOTHESIS",
        "SPECULATION",
        "ANALOGY",
        "DESIGN_HEURISTIC",
        "MATHEMATICAL_PROPERTY",
        "EMPIRICAL_HYPOTHESIS",
        "EMPIRICALLY_SUPPORTED"
      ]
    },
    "scope": {
      "type": "object",
      "required": ["system", "population_or_context"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "population_or_context": {"type": "string", "minLength": 1},
        "exclusions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "temporal_validity": {
      "type": "object",
      "required": ["valid_from", "review_by_or_condition"],
      "properties": {
        "valid_from": {"type": "string", "minLength": 1},
        "valid_until": {"type": ["string", "null"]},
        "review_by_or_condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "derivation_steps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_signature": {
      "type": "object",
      "required": ["status", "roots"],
      "properties": {
        "status": {"enum": ["KNOWN", "PARTIAL", "UNKNOWN_DEPENDENCE"]},
        "roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "supporting_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVID-[A-Z0-9][A-Z0-9._-]*$"}
    },
    "contradicting_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVID-[A-Z0-9][A-Z0-9._-]*$"}
    },
    "defeaters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defeater_id", "condition", "status"],
        "properties": {
          "defeater_id": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "status": {"enum": ["NOT_TRIGGERED", "TRIGGERED", "RESOLVED", "UNKNOWN"]}
        },
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "aleatoric",
        "model_or_parameter",
        "structural_or_model_form",
        "data_coverage",
        "provenance",
        "dependency",
        "measurement",
        "temporal",
        "adversarial",
        "decision_or_consequence"
      ],
      "properties": {
        "aleatoric": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "model_or_parameter": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "structural_or_model_form": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "data_coverage": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "provenance": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "dependency": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "measurement": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "temporal": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "adversarial": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]},
        "decision_or_consequence": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"const": "UNKNOWN"}]}
      },
      "additionalProperties": false
    },
    "calibration_status": {
      "enum": ["NOT_APPLICABLE", "NOT_CALIBRATED", "CALIBRATED_IN_SCOPE", "STALE", "UNKNOWN"]
    },
    "verification_status": {
      "enum": ["NOT_VERIFIED", "VERIFIED_IN_SCOPE", "INDEPENDENTLY_VERIFIED", "FAILED", "UNKNOWN"]
    },
    "epistemic_state": {
      "enum": ["PROPOSED", "SUPPORTED", "VERIFIED", "EMPIRICALLY_SUPPORTED"]
    },
    "applicability_state": {
      "enum": ["CURRENT", "CHALLENGED", "DEFEATED", "SUPERSEDED", "RETRACTED", "STALE", "OUT_OF_SCOPE"]
    },
    "causal_level": {
      "enum": ["ASSOCIATION", "PREDICTIVE", "INTERVENTION", "MECHANISM_HYPOTHESIS", "CAUSAL_IDENTIFIED"]
    },
    "authorization_relevance": {
      "enum": ["NONE", "ADVISORY", "REQUIRED_INPUT"]
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9._-]*$"}
    },
    "superseded_by": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9._-]*$"}
    },
    "retraction": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {"enum": ["NOT_RETRACTED", "RETRACTED"]},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
