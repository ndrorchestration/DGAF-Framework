{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndrorchestration/DGAF-Framework/blob/main/docs/governance/governed_repo_release_provenance.v1.schema.json",
  "title": "Governed Repo release provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "source",
    "package",
    "action",
    "verification",
    "workflow",
    "non_effects",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "governed_repo_release_provenance.v1"},
    "repository": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "canonical_source_path"],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "canonical_source_path": {"const": "packages/governed-repo/src/governed_repo/core.py"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version", "wheel", "sdist"],
      "properties": {
        "distribution": {"const": "ndrorchestration-governed-repo"},
        "version": {"type": "string", "minLength": 1},
        "wheel": {"$ref": "#/$defs/artifact"},
        "sdist": {"$ref": "#/$defs/artifact"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_sha"],
      "properties": {
        "path": {"const": "actions/governed-repo/action.yml"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_versions", "package_matrix_required"],
      "properties": {
        "python_versions": {
          "type": "array",
          "items": {"enum": ["3.10", "3.11", "3.12", "3.13", "3.14"]},
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        },
        "package_matrix_required": {"const": true}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "run_id", "run_attempt"],
      "properties": {
        "name": {"const": "Governed Repo Release Provenance"},
        "run_id": {"type": "string", "minLength": 1},
        "run_attempt": {"type": "string", "minLength": 1}
      }
    },
    "non_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge_executed", "mutation_executed", "authorization_effect"],
      "properties": {
        "merge_executed": {"const": false},
        "mutation_executed": {"const": false},
        "authorization_effect": {"const": "NONE"}
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
