{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "status": "AUDIT_CONTROL_NON_AUTHORITATIVE",
  "as_of": "2026-09-04",
  "dimensions": [
    {"id":"temporal","name":"Temporal Lineage","artifact_families":["timeline","decision log","amendment log","supersession ledger","historical snapshot"]},
    {"id":"taxonomy","name":"Taxonomy & Ontology","artifact_families":["entity registry","identifier registry","vocabulary","formation registry","instrument registry","pattern registry","state registry"]},
    {"id":"pattern","name":"Pattern Library","artifact_families":["pattern spec","pattern index","pattern dependency map","pattern lifecycle"]},
    {"id":"agentic","name":"Agentic Architecture","artifact_families":["agent identity","agent dossier","formation contract","authority matrix","integration contract","variant lineage"]},
    {"id":"layered","name":"Multi-Layer Control Architecture","artifact_families":["layer map","control-plane model","state machine","dependency graph","boundary map"]},
    {"id":"evidence","name":"Evidence & Provenance","artifact_families":["claim registry","metric provenance","attestation","execution artifact","reproduction record"]},
    {"id":"transversal","name":"Transversal Assurance","artifact_families":["cross-reference matrix","drift audit","contradiction register","impact set","promotion record"]}
  ],
  "relationship_types":["IMPLEMENTS","EXTENDS","ADAPTS","DERIVES_FROM","EVIDENCES","DEPENDS_ON","SUPERSEDES","CONFLICTS_WITH","HISTORICAL_OF"],
  "temporal_fields":["event_time","record_time","effective_time","discovery_time","resolution_time"],
  "control_layers":[
    {"id":"L0","name":"Identity & Legitimacy"},
    {"id":"L1","name":"Structural Integrity"},
    {"id":"L2","name":"Execution Integrity"},
    {"id":"L3","name":"Scientific Integrity"},
    {"id":"L4","name":"Governance Integrity"}
  ],
  "minimum_transversal_fields":["concept_id","identity","taxonomy","specification","implementation","test","evidence","governance","temporal_status","conflict_status"],
  "rules":[
    "Identity, seat, directory, formation membership, state, pattern, and rubric are distinct dimensions.",
    "Historical material must remain explicitly time/version scoped.",
    "Documentation presence does not imply implementation or validity.",
    "Downstream evidence inherits unresolved upstream dependency risk.",
    "A lower control layer cannot override a failed higher layer.",
    "A documentation change must declare its impact set when it touches high-impact concepts.",
    "No silent alias collapse, normalization, threshold substitution, or historical promotion."
  ]
}
