  },
  "input_contract": {
    "boolean_predicates": [
      "terminal",
      "blocked",
      "deadlock_candidate",
      "conflicted",
      "uncertain",
      "required_predicate_inconclusive"
    ],
    "tri_state_predicates": {
      "authorization": [
        "TRUE",
        "FALSE",
        "INCONCLUSIVE"
      ],
      "validation": [
        "TRUE",
        "FALSE",
        "INCONCLUSIVE"
      ],
      "provenance_valid": [
        "TRUE",
        "FALSE",
        "INCONCLUSIVE"
      ]
    },
    "invalid_input_decision": "HOLD"
  },
  "ordered_rules": [
    {
      "priority": 1,
      "when": "terminal == true",
      "decision": "RECORD_OUTCOME",
      "rule_id": "TERMINAL"
    },
    {
      "priority": 2,
      "when": "blocked == true",
      "decision": "ESCALATE_BLOCK",
      "rule_id": "BLOCKED"
    },
    {
      "priority": 3,
      "when": "deadlock_candidate == true",
      "decision": "PERTURB",
      "rule_id": "DEADLOCK_CANDIDATE"
    },
    {
      "priority": 4,
      "when": "conflicted == true",
      "decision": "ESCALATE_CONFLICT",
      "rule_id": "CONFLICTED"
    },
    {
      "priority": 5,
      "when": "uncertain == true",
      "decision": "REQUEST_EVIDENCE",
      "rule_id": "UNCERTAIN"
    },
    {
      "priority": 6,
      "when": "authorization == TRUE and validation == TRUE and provenance_valid == TRUE and no required predicate is INCONCLUSIVE",
      "decision": "EXECUTE",
      "rule_id": "AUTHORIZED_AND_VALIDATED_AND_PROVENANCE_VALID"
    },
    {
      "priority": 7,
      "when": "validation == TRUE and authorization == FALSE",
      "decision": "REQUEST_AUTHORIZATION",
      "rule_id": "VALIDATED_AND_NOT_AUTHORIZED"
    },
    {
      "priority": 8,
      "when": "required_predicate_inconclusive == true or authorization/validation/provenance_valid contains INCONCLUSIVE",
      "decision": "HOLD",
      "rule_id": "REQUIRED_PREDICATE_INCONCLUSIVE"
    },
    {
      "priority": 9,
      "when": "otherwise",
      "decision": "HOLD",
      "rule_id": "DEFAULT_FAIL_CLOSED"
    }
  ],
  "execution_boundary": {
