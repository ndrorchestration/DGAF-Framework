{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndrorchestration/DGAF-Framework/registry/governed_repo_release_provenance_v1.schema.json",
  "title": "Governed Repo release provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "controller_issue",
    "repository",
    "source",
    "package",
    "action",
    "compatibility",
    "workflow",
    "release_notes_ref",
    "non_effects",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "governed_repo.release_provenance.v1"},
    "evidence_class": {"const": "INTERNAL_RELEASE_CANDIDATE_PROVENANCE"},
    "controller_issue": {"const": "issue://1214"},
    "repository": {"const": "ndrorchestration/DGAF-Framework"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "canonical_source_path"],
      "properties": {
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "canonical_source_path": {"const": "packages/governed-repo/src/governed_repo/core.py"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution_name", "version", "wheel", "sdist"],
      "properties": {
        "distribution_name": {"const": "ndrorchestration-governed-repo"},
        "version": {"type": "string", "minLength": 1},
        "wheel": {"$ref": "#/$defs/artifact"},
        "sdist": {"$ref": "#/$defs/artifact"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_sha"],
      "properties": {
        "path": {"const": "actions/governed-repo"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_versions"],
      "properties": {
        "python_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^3\\.[0-9]+$"}
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "run_id", "source_sha"],
      "properties": {
        "name": {"const": "Governed Repo P0 Package"},
        "run_id": {"type": "string", "pattern": "^[0-9]+$"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "release_notes_ref": {"type": "string", "minLength": 1},
    "non_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge_executed", "mutation_executed", "authorization_effect", "publication_effect"],
      "properties": {
        "merge_executed": {"const": false},
        "mutation_executed": {"const": false},
        "authorization_effect": {"const": "NONE"},
        "publication_effect": {"const": "NONE"}
      }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_readiness",
        "independent_validation",
        "production_security",
        "compliance_certification",
        "high_assurance",
        "product_market_fit"
      ],
      "properties": {
        "publication_readiness": {"const": "NOT_ESTABLISHED"},
        "independent_validation": {"const": "NOT_ESTABLISHED"},
        "production_security": {"const": "NOT_ESTABLISHED"},
        "compliance_certification": {"const": "NOT_ESTABLISHED"},
        "high_assurance": {"const": "NOT_AUTHORIZED"},
        "product_market_fit": {"const": "NOT_ESTABLISHED"}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
